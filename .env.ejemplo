# Copia este archivo como .env y llena los valores. .env NUNCA se sube (está en .gitignore).
# Las claves las escribe una persona; un agente de IA no las pide por chat ni las imprime.

# URL del proyecto de Supabase (sin /rest/v1)
SUPABASE_URL=https://<proyecto>.supabase.co

# Clave publicable (sb_publishable_…): solo lee. La usan la verificación y la prueba de recuperación.
SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (sb_secret_…): escribe. Solo la usa el indexador. Supabase → Project Settings → API Keys.
SUPABASE_SECRET_KEY=

# Token de GitHub de SOLO LECTURA, para leer el repositorio privado de Amatista (2 documentos del canon).
# Crear en GitHub → Settings → Developer settings → Fine-grained tokens: solo el repositorio
# amatista-recuperada-20261106, permiso «Contents: Read-only», con fecha de vencimiento.
GITHUB_TOKEN=

# MongoDB, SOLO LECTURA (rol `read` sobre conocimiento_3d): la muestra de la prueba del revisor.
# No uses el usuario que publica. En Atlas, agrega la IP del laboratorio en Network Access.
MONGO_URI_LECTURA=
MONGO_DATABASE=conocimiento_3d

# Ollama local (no cambiar salvo que se haya movido de puerto; nunca 0.0.0.0)
OLLAMA_HOST=http://127.0.0.1:11434
